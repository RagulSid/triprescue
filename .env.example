# Copy to .env and fill in. Never commit .env.
# These values are entered in Switch Console (Home > Messaging apps > Connect).

# Slack (see https://docs.switchagents.ai/switch-rooms/deploy/messaging-apps/slack)
SLACK_WORKSPACE_ID=        # starts with T
SLACK_WORKSPACE_URL=
SLACK_APP_TOKEN=           # app-level token with connections:write, starts with xapp-
SLACK_BOT_TOKEN=           # Bot User OAuth Token, starts with xoxb-

# Telegram (see https://docs.switchagents.ai/switch-rooms/deploy/messaging-apps/telegram)
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_BOT_USERNAME=     # ends with "bot"
